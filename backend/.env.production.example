# ==========================================
# Quisqueya Talent - Backend Environment (Production)
# Copia estas variables en el panel de Render.com
# ==========================================

PORT=5000
NODE_ENV=production

# Cadena de conexión de TiDB Cloud Serverless (MySQL con SSL)
# Formato: mysql://<USER>:<PASSWORD>@<HOST>:4000/<DATABASE>?sslaccept=strict
DATABASE_URL="mysql://usuario:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/quisqueyatalent_db?sslaccept=strict"

# Llave secreta para JWT (genera una cadena aleatoria y segura)
JWT_SECRET="quisqueya_talent_prod_jwt_super_secret_key_2026_rd"
JWT_EXPIRES_IN="7d"

# URL de tu frontend en Vercel (o tu dominio personalizado)
CORS_ORIGIN="https://tu-proyecto.vercel.app"

# Proveedor de IA para el asistente de CV y cartas (mock o gemini)
AI_PROVIDER="mock"
GEMINI_API_KEY=""
