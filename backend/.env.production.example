# ==========================================
# Quisqueya Talent - Backend Environment (Production)
# Copia estas variables en el panel de Render.com / Railway / VPS
# ==========================================

PORT=5000
NODE_ENV=production

# 1. Base de datos MySQL / TiDB Cloud / PlanetScale / RDS
DATABASE_URL="mysql://usuario:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/quisqueyatalent_db?sslaccept=strict"

# 2. Seguridad JWT (Genera una clave aleatoria y segura)
JWT_SECRET="quisqueya_talent_prod_jwt_super_secret_key_2026_rd"
JWT_EXPIRES_IN="7d"

# 3. CORS: Dominio de tu Frontend
CORS_ORIGIN="https://www.quisqueyatalent.com.do,https://quisqueyatalent.com.do"

# 4. Inteligencia Artificial (Gemini API para creador de CV y ATS)
AI_PROVIDER="gemini"
GEMINI_API_KEY=""

# 5. Servicio de Correos Electrónicos (Resend - 100% Gratuito hasta 3,000 correos/mes)
# Crea tu cuenta en https://resend.com y genera una API Key
RESEND_API_KEY=""
FROM_EMAIL="Quisqueya Talent <notificaciones@quisqueyatalent.com.do>"

# 6. Almacenamiento en la Nube (Cloudflare R2 - Gratuito hasta 10 GB)
# Configura tu bucket en Cloudflare Dashboard -> R2 Object Storage
STORAGE_PROVIDER="r2"
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="quisqueyatalent-storage"
CLOUDFLARE_R2_PUBLIC_DOMAIN="https://pub-xxxxxx.r2.dev"

# 7. Escudo Anti-Cobros de R2 (Garantiza que no excedas el límite gratuito de 10 GB)
STORAGE_GUARD_ACTIVE="true"
STORAGE_GUARD_MAX_GB="9.0"
